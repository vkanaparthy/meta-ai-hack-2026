# Meta Model API (https://dev.meta.ai/docs/models). Copy to .env and fill in; never commit .env.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_REASONING_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
# Open weights: Muse Spark Open on Baseten (OpenAI-compatible Chat Completions).
# Set MUSE_PROVIDER=open (or pass --provider open) to run smoke checks and the agent on it.
MUSE_PROVIDER=meta
OPEN_MODEL_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL_API_KEY=
OPEN_MODEL_NAME=meta-models/muse-spark-open-1026
# Cost meter: calls stop once outputs/usage_open.jsonl adds up to the budget.
OPEN_MODEL_BUDGET_USD=90
OPEN_MODEL_USD_PER_M_IN=1.25
OPEN_MODEL_USD_PER_M_OUT=4.25

# Muse Glimmer 30B (Apache 2.0). Set MUSE_PROVIDER=glimmer or pass --provider glimmer.
# Baseten dedicated deployment (one H100, billed by GPU time; scale it to zero when done):
#   GLIMMER_BASE_URL=https://model-<model id>.api.baseten.co/environments/production/sync/v1
#   GLIMMER_API_KEY=<your Baseten key>
#   GLIMMER_MODEL=meta-models/Muse-Glimmer-30B
# Or locally with Ollama on Apple Silicon (`ollama pull muse-glimmer:30b-mlx`):
GLIMMER_BASE_URL=http://localhost:11434/v1
GLIMMER_MODEL=muse-glimmer:30b-mlx
GLIMMER_REASONING=medium
